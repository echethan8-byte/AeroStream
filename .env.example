# Copy to .env and fill in. Never commit .env.

# ---- Monitored airports (BLR, DEL, BOM, MAA are pre-configured) ----
AIRPORT_CODE=BLR
AIRPORT_CODES=BLR,BOM,DEL,MAA

# ---- Run without API keys: producers emit clearly-labelled synthetic data (source="mock") ----
MOCK_MODE=false

# ---- Kafka (host-side address; containers use kafka:9092 automatically) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ---- OpenSky (OAuth2 client credentials; leave empty for anonymous, heavily rate-limited) ----
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_SECONDS=30
# Half-width of the bounding box around the airport, in degrees (0.5 deg ~ 55 km)
BBOX_RADIUS_DEG=0.5
# Radius of the "terminal area" used to classify arriving/departing aircraft
TERMINAL_RADIUS_DEG=0.25

# ---- Aviationstack ----
AVIATIONSTACK_API_KEY=
# Free plans only support http://. Paid plans can use https://api.aviationstack.com/v1
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
# Each cycle makes 2 requests (arrivals + departures). Free-tier quotas are small:
# keep this high unless you are on a paid plan.
AVIATIONSTACK_POLL_SECONDS=900
AVIATIONSTACK_MAX_PAGES=1

# ---- Open-Meteo (no key needed) ----
WEATHER_POLL_SECONDS=300

# ---- Metric definitions ----
ON_TIME_THRESHOLD_MIN=15
# Movements/hour at which the airport is considered "full" (congestion_index = 1.0)
CAPACITY_MOVEMENTS_PER_HOUR=40

# ---- PostgreSQL ----
POSTGRES_USER=flight
POSTGRES_PASSWORD=flight_pw
POSTGRES_DB=flight_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Superset (development defaults: change before exposing anywhere) ----
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
